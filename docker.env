# Docker Environment Configuration
# This file contains environment variables for Docker deployment

# Database Configuration
DATABASE_URL=postgresql+psycopg2://postgres:password@db:5432/recipe
DB_HOST=db
DB_PORT=5432
DB_NAME=recipe
DB_USER=postgres
DB_PASSWORD=password
DB_DRIVER=postgresql+psycopg2

# Application Configuration
SECRET_KEY=your-production-secret-key-change-this-in-production
ALLOWED_ORIGINS=["*"]
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FILE=app.log
LOG_FORMAT=%(levelname)-8s %(asctime)s %(name)s.%(module)s:%(lineno)s | %(message)s
LOG_BODY=false
LOGGER_TYPE=production

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cache Configuration
CACHE_TTL=300
ENABLE_CACHE=true

# Redis Configuration (if using Redis)
REDIS_URL=redis://redis:6379/0

# Authentication Bypass (for development only)
AUTH_BYPASS_EMAIL=test@example.com
